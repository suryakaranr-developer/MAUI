<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tokens="clr-namespace:CompanyName.AppName.Design.MAUI.Material.Tokens"
             Title="Colour roles"
             x:Class="CompanyName.AppName.Design.MAUI.SystemDesigns.Material.MaterialColorRoles">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="8">

            <tokens:BodyMedium Text="A role says what a colour is for, not what it looks like. Each swatch draws its matching content role on top, which is the pairing that guarantees contrast." />

            <!-- Swatches are built in code so they read from the same token class the components
                 do, rather than restating every value here. -->
            <VerticalStackLayout x:Name="Swatches" Spacing="8" Margin="0,16,0,24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
