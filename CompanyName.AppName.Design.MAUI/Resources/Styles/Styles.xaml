<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <!-- <ResourceDictionary Source="Branding.xaml"/> -->
        <ResourceDictionary Source="Buttons.xaml"/>
        <!-- <ResourceDictionary Source="Notifications.xaml"/> -->
        <!-- <ResourceDictionary Source="Typography.xaml"/> -->
        <!-- <ResourceDictionary Source="ContentDivider.xaml"/> -->
        <!-- <ResourceDictionary Source="Selector.xaml"/> -->
        <!-- <ResourceDictionary Source="Inputs.xaml"/> -->
    </ResourceDictionary.MergedDictionaries>
 <!-- ActivityIndicator -->
     <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryBlue}, Dark={StaticResource PrimaryBlue_Dark}}" />
    </Style>

    <!-- Page -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Surface_Dark}}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Surface_Dark}}" />
    </Style>

    <!-- WebView -->
    <Style TargetType="WebView" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Surface_Dark}}" />
    </Style>

    <!-- Label -->
    <Style TargetType="Label" ApplyToDerivedTypes="True">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="MontserratRegular"/>
        <Setter Property="FontAttributes" Value="None"/>
        <Setter Property="CharacterSpacing" Value="1"/>
        <Setter Property="TextTransform" Value="None"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryInfo}, Dark={StaticResource PrimaryInfo_Dark}}"/>
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Surface_Dark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource PrimaryBlue}, Dark={StaticResource PrimaryBlue_Dark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>

