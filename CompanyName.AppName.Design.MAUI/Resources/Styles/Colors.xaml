    <Color x:Key="SurfaceHighlight80">#ccffffff</Color>
    <Color x:Key="LightGray">#dfe3e8</Color>

    <!-- Dark Colors -->
    <Color x:Key="PrimaryBlue_Dark">#0093f0</Color>
    <Color x:Key="PrimaryInfo_Dark">#f2f2f2</Color>
