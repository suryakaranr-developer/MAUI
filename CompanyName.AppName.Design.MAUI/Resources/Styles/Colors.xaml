<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Light Colors -->
    <Color x:Key="PrimaryBlue">#102b4e</Color>
    <Color x:Key="PrimaryInfo">#4d4d4d</Color>
    <Color x:Key="SecondaryInfo">#6e6e6e</Color>
    <Color x:Key="Disabled">#8c8c8c</Color>
    <Color x:Key="Divider">#c8c8c8</Color>
    <Color x:Key="Success">#008200</Color>
    <Color x:Key="Warning">#da7029</Color>
    <Color x:Key="WarningText">#ba4e00</Color>
    <Color x:Key="Error">#d62d0a</Color>
    <Color x:Key="GradientBlue">#0275eb</Color>
