    <Color x:Key="Warning_Dark">#da7029</Color>
    <Color x:Key="WarningText_Dark">#da7029</Color>
    <Color x:Key="Error_Dark">#ff3030</Color>
    <Color x:Key="GradientBlue_Dark">#0093f0</Color>
    <Color x:Key="SecondaryBlue_Dark">#0275eb</Color>
    <Color x:Key="Surface_Dark">#1a1f26</Color>
    <Color x:Key="Surface80_Dark">#cc1a1f26</Color>
    <Color x:Key="Surface0_Dark">#101a1f26</Color>
    <Color x:Key="SurfaceHighlight_Dark">#212830</Color>
    <Color x:Key="SurfaceHigh_Dark">#212830</Color>
    <Color x:Key="SurfaceHighlight80_Dark">#cc212830</Color>
    <Color x:Key="LightGray_Dark">#6e6e6e</Color>


    <Color x:Key="Black">#000000</Color>
    <Color x:Key="White">#ffffff</Color>

    <!--Module Colors-->
    <Color x:Key="ConditionsNotCorrect">#FFBF00</Color>

